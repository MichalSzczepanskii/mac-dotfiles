<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Idle LSP stop (#83): every 5 min, and on wake if a run was missed. Install copies this into ~/Library/LaunchAgents. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.memory.lsp-idle</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>"$HOME/.config/memory/lsp-idle" stop</string>
  </array>
  <key>StartInterval</key>
  <integer>300</integer>
</dict>
</plist>
